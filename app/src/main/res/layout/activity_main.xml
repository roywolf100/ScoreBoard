<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp" android:background="@color/screen_bg">

 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:id="@+id/tvTitle"
     android:gravity="center"
     android:text="@string/game_name"
     android:textSize="28sp"
     android:textStyle="bold"     />

    <Button
        android:id="@+id/btnWhistle"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/header_btn"
        android:layout_marginTop="2dp"
        android:layout_gravity="center_horizontal"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">


        <LinearLayout
            android:layout_width= "0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/group_a_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvNameA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group1_name"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/initial_score"
                android:textSize="64sp" />

            <Button
                android:id="@+id/btnA3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add3"
                android:backgroundTint="@color/group_a3_btn"
                android:textStyle="bold"
                />



            <Button
                android:id="@+id/btnA2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add2"
                android:backgroundTint="@color/group_a2_btn"
                android:textStyle="bold"
                />



            <Button
                android:id="@+id/btnA1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/add1"
                android:backgroundTint="@color/group_a1_btn"
                android:layout_marginBottom="100dp"/>

            <Button
                android:id="@+id/btnAm1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/minus_btn"
                android:text="@string/minus1"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/group_b_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:id="@+id/tvNameB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group2_name"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/initial_score"
                android:textSize="64sp" />

            <Button
                android:id="@+id/btnB3"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add3"
                android:backgroundTint="@color/group_b3_btn"
                />

            <Button
                android:id="@+id/btnB2"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add2"
                android:backgroundTint="@color/group_b2_btn"
                />

            <Button
                android:id="@+id/btnB1"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add1"
                android:backgroundTint="@color/group_b1_btn"
                android:layout_marginBottom="100dp"/>

            <Button
                android:id="@+id/btnBm1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/minus1"
                android:backgroundTint="@color/minus_btn"
                android:textStyle="bold"
                />


        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center">
    <Button
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/btn_reset"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/reset"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="30dp"
        android:textSize="18sp" />

        <Button
            android:id="@+id/btnEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/end_game_btn"
            android:paddingStart="32dp"
            android:layout_weight="1"
            android:paddingEnd="32dp"

            android:text="@string/end"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
